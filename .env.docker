# VoiceFillPrescription Backend - Docker Development Environment
# Copy this file to .env for local Docker development

# Application
APP_NAME=VoiceFillPrescription
VERSION=0.1.0

# Whisper STT - Use CPU for Docker compatibility (no GPU in container by default)
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo
DEVICE=cpu

# HuggingFace cache - Use persistent volume in Docker
HF_HOME=/models/huggingface

# Timeout for model download in seconds (default: 600 = 10 minutes)
HF_HUB_DOWNLOAD_TIMEOUT=600

# Database - Use service name 'db' in Docker Compose
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/voicefillprescription
DATABASE_POOL_SIZE=5
DATABASE_MAX_OVERFLOW=10
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE=3600

# Server
HOST=0.0.0.0
PORT=8000
