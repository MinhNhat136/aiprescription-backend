# Application settings
APP_NAME=VoiceFillPrescription

# Whisper model configuration
# Options: tiny, base, small, medium, large-v3, large-v3-turbo
WHISPER_MODEL=large-v3-turbo

# Optional: Override local model directory (defaults to HuggingFace cache ~/.cache/huggingface/hub/)
# Example: D:\Models\whisper
# WHISPER_MODEL_PATH=

# Optional: HuggingFace cache directory for model storage
# Example: D:\Models\huggingface
# HF_HOME=

# Timeout for model download in seconds (default: 600 = 10 minutes)
# HF_HUB_DOWNLOAD_TIMEOUT=600

# Device for inference: cuda, cpu
DEVICE=cuda

# HuggingFace cache directory for storing Whisper models (default: ~/.cache/huggingface/hub)
# Set this to a local directory to control where models are stored
# HF_HOME=C:\Users\<username>\.cache\huggingface\hub

# Optional: Direct path to a pre-downloaded model directory
# If set, faster-whisper will load from this path instead of downloading
# WHISPER_MODEL_PATH=C:\Users\<username>\whisper_models

# Timeout for initial model download in seconds (default: 600 = 10 minutes)
# Increase if running on slow network for large models (~6GB for large-v3-turbo)
# HF_HUB_DOWNLOAD_TIMEOUT=600

# Database URL (PostgreSQL with asyncpg)
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/voicefillprescription

# Database connection pool settings
# Pool size: number of persistent connections
DATABASE_POOL_SIZE=5

# Max overflow: additional connections when pool is exhausted
DATABASE_MAX_OVERFLOW=10

# Pool timeout: seconds to wait for available connection
DATABASE_POOL_TIMEOUT=30

# Pool recycle: seconds before connection is recycled (prevents stale connections)
DATABASE_POOL_RECYCLE=3600

# Server configuration
# HOST=0.0.0.0
# PORT=8000
